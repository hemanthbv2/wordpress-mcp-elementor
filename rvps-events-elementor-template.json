              "settings": {
                "html": "\n<div id=\"events-list\" style=\"font-family:'Inter',sans-serif; padding: 25px 0; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:20px;\">\n  <!-- Title with Striped Pattern -->\n  <div style=\"background:#f4ece2; padding:12px 28px; border-radius:16px; border-left:6px solid #f3b23e;\">\n    <h2 style=\"font-family:'Inria Serif',Georgia,serif; font-size:38px; font-weight:700; color:#1c1c1c; margin:0;\">\n      Events & News\n    </h2>\n  </div>\n\n  <!-- Year Filter Pills -->\n  <div style=\"display:flex; gap:12px; flex-wrap:wrap;\">\n    <span style=\"background:#f2563d; color:#ffffff; font-family:'Inria Serif',Georgia,serif; font-size:18px; font-weight:700; padding:8px 30px; border-radius:30px; cursor:pointer; box-shadow:0 4px 12px rgba(242,86,61,0.3);\">\n      2022\n    </span>\n    <span style=\"background:#ffffff; border:1.5px solid #1c1c1c; color:#1c1c1c; font-family:'Inria Serif',Georgia,serif; font-size:18px; font-weight:700; padding:8px 30px; border-radius:30px; cursor:pointer;\">\n      2023\n    </span>\n    <span style=\"background:#ffffff; border:1.5px solid #1c1c1c; color:#1c1c1c; font-family:'Inria Serif',Georgia,serif; font-size:18px; font-weight:700; padding:8px 30px; border-radius:30px; cursor:pointer;\">\n      2024\n    </span>\n    <span style=\"background:#ffffff; border:1.5px solid #1c1c1c; color:#1c1c1c; font-family:'Inria Serif',Georgia,serif; font-size:18px; font-weight:700; padding:8px 30px; border-radius:30px; cursor:pointer;\">\n      2025\n    </span>\n  </div>\n</div>\n"
              },
