          "elements": [
            {
              "id": "00f4248",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "\n<div style=\"font-family:'Inter',sans-serif; padding: 30px 0 20px 0; display:flex; flex-wrap:wrap; gap:30px; align-items:stretch;\">\n  <!-- Left Column: Coral Container with Mascot -->\n  <div style=\"flex:1.2 1 480px; background:#f2563d; border-radius:36px; padding:45px 40px 30px 40px; color:#ffffff; position:relative; box-shadow:0 15px 40px rgba(242,86,61,0.25); display:flex; flex-direction:column; justify-content:space-between;\">\n    <div>\n      <div style=\"display:flex; justify-content:space-between; align-items:center; margin-bottom:25px;\">\n        <div style=\"background:#1c1c1c; color:#ffffff; font-size:12px; font-weight:800; text-transform:uppercase; letter-spacing:1.5px; padding:6px 18px; border-radius:20px;\">\n          • LIFE AT RVPS\n        </div>\n        <div style=\"width:36px; height:36px; background:#f3b23e; border-radius:50%; display:flex; align-items:center; justify-content:center; color:#1c1c1c; font-size:20px; font-weight:900;\">\n          +\n        </div>\n      </div>\n\n      <h1 style=\"font-family:'Inria Serif',Georgia,serif; font-size:54px; font-weight:700; line-height:1.15; margin:0 0 15px 0; color:#1c1c1c;\">\n        Empowering &<br>engaging students<br><span style=\"color:#ffffff; font-style:italic;\">beyond classrooms.</span>\n      </h1>\n    </div>\n\n    <!-- Mascot Pointing -->\n    <div style=\"text-align:right; margin-top:20px;\">\n      <img src=\"https://raw.githubusercontent.com/hemanthbv2/rvpu-assets/main/rvps/events-eagle-jersey.png\" alt=\"Eagle Mascot in RV Jersey\" style=\"max-height:300px; object-fit:contain; filter:drop-shadow(0 10px 20px rgba(0,0,0,0.2));\" />\n    </div>\n  </div>\n\n  <!-- Right Column: Dark News & Events + Gold 80+ Legacy Card -->\n  <div style=\"flex:1 1 420px; display:flex; flex-direction:column; gap:25px;\">\n    <!-- Dark Container -->\n    <div style=\"background:#1c1c1c; border-radius:32px; padding:35px 30px; color:#ffffff; box-shadow:0 15px 40px rgba(0,0,0,0.2);\">\n      <div style=\"display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;\">\n        <h3 style=\"font-family:'Inter',sans-serif; font-size:18px; font-weight:700; margin:0;\">News & Events</h3>\n        <span style=\"font-size:11px; font-weight:800; color:#f2563d; text-transform:uppercase; letter-spacing:1px;\">• LATEST</span>\n      </div>\n\n      <!-- 3 Stage Photos -->\n      <div style=\"display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:18px;\">\n        <div style=\"grid-column:span 2; height:120px; border-radius:14px; overflow:hidden;\">\n          <img src=\"https://raw.githubusercontent.com/hemanthbv2/rvpu-assets/main/rvps/home-event-1.png\" alt=\"Event Banner\" style=\"width:100%; height:100%; object-fit:cover;\" />\n        </div>\n        <div style=\"height:100px; border-radius:14px; overflow:hidden;\">\n          <img src=\"https://raw.githubusercontent.com/hemanthbv2/rvpu-assets/main/rvps/home-event-2.png\" alt=\"Event 2\" style=\"width:100%; height:100%; object-fit:cover;\" />\n        </div>\n        <div style=\"height:100px; border-radius:14px; overflow:hidden;\">\n          <img src=\"https://raw.githubusercontent.com/hemanthbv2/rvpu-assets/main/rvps/home-event-3.png\" alt=\"Event 3\" style=\"width:100%; height:100%; object-fit:cover;\" />\n        </div>\n      </div>\n\n      <a href=\"#events-list\" style=\"display:inline-block; font-size:13.5px; font-weight:600; color:#a0a0a0; text-decoration:none;\">\n        See what's happening on campus ↗\n      </a>\n    </div>\n\n    <!-- Gold 80+ Legacy Card -->\n    <div style=\"background:#f3b23e; border-radius:28px; padding:30px; color:#1c1c1c; display:flex; align-items:center; gap:20px; box-shadow:0 10px 30px rgba(243,178,62,0.25);\">\n      <div style=\"font-family:'Inria Serif',Georgia,serif; font-size:48px; font-weight:800; line-height:1;\">\n        80+\n      </div>\n      <p style=\"font-size:15px; font-weight:600; line-height:1.5; margin:0; color:#3a3a3a;\">\n        years of the Rashtreeya Sikshana Samithi Trust legacy in education\n      </p>\n    </div>\n  </div>\n</div>\n"
              },
              "elements": []
            }
          ]
        }
      ]
    },
