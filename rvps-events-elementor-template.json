font-family:'Inter',sans-serif; font-size:18px; font-weight:700; line-height:1.4; margin:0 0 10px 0;\">\n          Sampada 2023 – Annual Day celebration of RV Public School\n        </h3>\n        <p style=\"font-size:14px; opacity:0.95; line-height:1.5; margin:0 0 20px 0;\">\n          Sampada 2023 – The Annual Day ...\n        </p>\n        <div style=\"text-align:right;\">\n          <a href=\"#\" style=\"color:#ffffff; font-size:22px; text-decoration:none; font-weight:bold;\">————➔</a>\n        </div>\n      </div>\n      <div style=\"height:220px; overflow:hidden;\">\n        <img src=\"https://raw.githubusercontent.com/hemanthbv2/rvpu-assets/main/rvps/events-card-5.png\" alt=\"Students with Trophies\" style=\"width:100%; height:100%; object-fit:cover;\" />\n      </div>\n    </div>\n\n    <!-- Card 6: Gold Top (Row 2) -->\n    <div style=\"border-radius:26px; overflow:hidden; box-shadow:0 12px 30px rgba(0,0,0,0.08); display:flex; flex-direction:column;\">\n      <div style=\"background:#f3b23e; padding:30px 28px 24px 28px; color:#1c1c1c;\">\n        <div style=\"font-family:'Inria Serif',Georgia,serif; font-size:26px; font-weight:700; margin-bottom:12px; border-bottom:1.5px solid #1c1c1c; padding-bottom:6px; display:inline-block;\">\n          December 2023\n        </div>\n        <h3 style=\"font-family:'Inter',sans-serif; font-size:18px; font-weight:700; line-height:1.4; margin:0 0 10px 0;\">\n          Sampada 2023 – Annual Day celebration of RV Public School\n        </h3>\n        <p style=\"font-size:14px; opacity:0.95; line-height:1.5; margin:0 0 20px 0; color:#3a3a3a;\">\n          Sampada 2023 – The Annual Day ...\n        </p>\n        <div style=\"text-align:right;\">\n          <a href=\"#\" style=\"color:#1c1c1c; font-size:22px; text-decoration:none; font-weight:bold;\">————➔</a>\n        </div>\n      </div>\n      <div style=\"height:220px; overflow:hidden;\">\n        <img src=\"https://raw.githubusercontent.com/hemanthbv2/rvpu-assets/main/rvp