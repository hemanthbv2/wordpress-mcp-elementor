              "settings": {
                "html": "\n<style>\n.rvps-footer { font-family: 'Inter', sans-serif; color: #ffffff; padding: 60px 40px 25px 40px; background: #3a3a3a; }\n.rvps-footer h3 { font-family: 'Inria Serif', Georgia, serif; font-size: 26px; color: #ffffff; margin-bottom: 22px; font-weight: 700; position: relative; padding-bottom: 8px; }\n.rvps-footer h3::after { content: ''; position: absolute; bottom: 0; left: 0; width: 48px; height: 3px; background: #f3b23e; border-radius: 2px; }\n.rvps-footer-grid { display: grid; grid-template-columns: 1.5fr 1fr 1fr 1.2fr; gap: 40px; }\n.rvps-footer p { font-size: 14.5px; line-height: 1.7; color: #e0e0e0; margin: 0 0 12px 0; }\n.rvps-footer a { color: #f3b23e; text-decoration: none; transition: color 0.2s; }\n.rvps-footer a:hover { color: #ffffff; text-decoration: underline; }\n.rvps-footer-links { list-style: none; padding: 0; margin: 0; }\n.rvps-footer-links li { margin-bottom: 10px; font-size: 14.5px; }\n.rvps-footer-links a { color: #d5d5d5; }\n.rvps-footer-links a:hover { color: #f3b23e; padding-left: 4px; }\n.rvps-footer-bottom { border-top: 1px solid rgba(255,255,255,0.15); margin-top: 45px; padding-top: 22px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; font-size: 13.5px; color: #a8a8a8; }\n@media (max-width: 900px) {\n  .rvps-footer-grid { grid-template-columns: 1fr 1fr; }\n}\n@media (max-width: 600px) {\n  .rvps-footer-grid { grid-template-columns: 1fr; gap: 28px; }\n  .rvps-footer { padding: 40px 20px 20px 20px; }\n  .rvps-footer-bottom { flex-direction: column; text-align: center; gap: 10px; }\n}\n</style>\n<footer class=\"rvps-footer\">\n  <div class=\"rvps-footer-grid\">\n    <div>\n      <img src=\"https://raw.githubusercontent.com/hemanthbv2/rvpu-assets/main/rvps/rvps-logo.png\" alt=\"RV Public School\" style=\"max-width: 210px; margin-bottom: 18px; filter: brightness(0) invert(1);\" />\n      <p style=\"font-weight: 600; color: #ffffff; font-size: 15px;\">RV Public School</p>\n      <p>Rashtreeya Sikshana Samithi Trust (RSST)<br>#45/1, 22nd Cross, 3rd Block, Jayanagar,<br>Bengaluru – 560 011, Karnataka, India</p>\n    </div>\n    <div>\n      <h3>Quick Links</h3>\n      <ul class=\"rvps-footer-links\">\n        <li><a href=\"https://rvcollegeofengineering.in/test/?page_id=99\">Home</a></li>\n        <li><a href=\"https://rvcollegeofengineering.in/test/?page_id=100\">About Us</a></li>\n        <li><a href=\"https://rvcollegeofengineering.in/test/?page_id=101\">Academics</a></li>\n        <li><a href=\"https://rvcollegeofengineering.in/test/?page_id=102\">Events</a></li>\n        <li><a href=\"https://rvcollegeofengineering.in/test/?page_id=103\">Results</a></li>\n        <li><a href=\"https://rvcollegeofengineering.in/test/?page_id=104\">Alumni</a></li>\n        <li><a href=\"https://rvcollegeofengineering.in/test/?page_id=105\">Contact Us</a></li>\n      </ul>\n    </div>\n    <div>\n      <h3>Contact Us</h3>\n      <p><strong>Phone:</strong><br><a href=\"tel:+918069018952\">+91-80-69018952</a> / <a href=\"tel:+918069018953\">53</a></p>\n      <p><strong>Email:</strong><br><a href=\"mailto:rvils@rvei.edu.in\">rvils@rvei.edu.in</a></p>\n      <p><strong>Office Hours:</strong><br>Mon – Sat: 8:30 AM – 4:00 PM</p>\n    </div>\n    <div>\n      <h3>Accreditation</h3>\n      <p>Affiliated to Council for the Indian School Certificate Examinations (CISCE), New Delhi</p>\n      <p>School Code: <strong>KA083</strong></p>\n      <p style=\"margin-top: 15px; color: #f3b23e; font-weight: 600;\">Inspiring Excellence Since 1940</p>\n    </div>\n  </div>\n  <div class=\"rvps-footer-bottom\">\n    <span>© 2026 Rashtreeya Sikshana Samithi Trust (RSST). All rights reserved.</span>\n    <span>Department of Alumni Affairs & Communication</span>\n  </div>\n</footer>\n"
              },
