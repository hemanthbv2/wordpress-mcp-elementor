          "settings": {
            "_column_size": 100,
            "_inline_size": 100
          },
          "elements": [
            {
              "id": "00f4248",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "\n<div style=\"font-family:'Inter',sans-serif; padding: 40px 0 60px 0;\">\n  <!-- Page Title -->\n  <div style=\"margin-bottom: 40px;\">\n    <h1 style=\"font-family:'Inria Serif',Georgia,serif; font-size:62px; font-weight:700; color:#855d14; margin:0; letter-spacing:1px;\">\n      CONTACT US\n    </h1>\n  </div>\n\n  <div style=\"display:flex; flex-wrap:wrap; gap:40px; align-items:flex-start;\">\n    <!-- Left Column: 4 White Cards with Exact Icons -->\n    <div style=\"flex:1 1 380px; display:flex; flex-direction:column; gap:20px;\">\n      <!-- Card 1: Address -->\n      <div style=\"background:#ffffff; border-radius:22px; padding:22px 28px; display:flex; align-items:center; gap:22px; box-shadow:0 8px 24px rgba(0,0,0,0.06);\">\n        <img src=\"https://raw.githubusercontent.com/hemanthbv2/rvpu-assets/main/rvps/contact-icon-pin.png\" alt=\"Address Pin\" style=\"width:62px; height:62px; object-fit:contain;\" />\n        <div>\n          <h4 style=\"font-family:'Inter',sans-serif; font-size:16px; font-weight:800; color:#1c1c1c; margin:0 0 6px 0;\">\n            Address:\n          </h4>\n          <p style=\"font-size:14.5px; line-height:1.55; color:#454545; margin:0;\">\n            RV Public School,<br>\n            Opposite Lalbagh West Gate, V V Puram,<br>\n            Bangalore, Karnataka – 560004\n          </p>\n        </div>\n      </div>\n\n      <!-- Card 2: Call Us -->\n      <div style=\"background:#ffffff; border-radius:22px; padding:22px 28px; display:flex; align-items:center; gap:22px; box-shadow:0 8px 24px rgba(0,0,0,0.06);\">\n        <img src=\"https://raw.githubusercontent.com/hemanthbv2/rvpu-assets/main/rvps/contact-icon-phone.png\" alt=\"Phone\" style=\"width:62px; height:62px; object-fit:contain;\" />\n        <div>\n          <h4 style=\"font-family:'Inter',sans-serif; font-size:16px; font-weight:800; color:#1c1c1c; margin:0 0 6px 0;\">\n            Call Us:\n          </h4>\n          <p style=\"font-size:16px; font-weight:600; color:#454545; margin:0;\">\n            <a href=\"tel:+9108069757300\" style=\"color:#1c1c1c; text-decoration:none;\">+91-080-69757300</a>\n          </p>\n        </div>\n      </div>\n\n      <!-- Card 3: Email -->\n      <div style=\"background:#ffffff; border-radius:22px; padding:22px 28px; display:flex; align-items:center; gap:22px; box-shadow:0 8px 24px rgba(0,0,0,0.06);\">\n        <img src=\"https://raw.githubusercontent.com/hemanthbv2/rvpu-assets/main/rvps/contact-icon-email.png\" alt=\"Email\" style=\"width:62px; height:62px; object-fit:contain;\" />\n        <div>\n          <h4 style=\"font-family:'Inter',sans-serif; font-size:16px; font-weight:800; color:#1c1c1c; margin:0 0 6px 0;\">\n            Email:\n          </h4>\n          <p style=\"font-size:15px; font-weight:600; color:#454545; margin:0;\">\n            <a href=\"mailto:rvps@rvei.edu.in\" style=\"color:#1c1c1c; text-decoration:none;\">rvps@rvei.edu.in</a>\n          </p>\n        </div>\n      </div>\n\n      <!-- Card 4: Office Hours -->\n      <div style=\"background:#ffffff; border-radius:22px; padding:22px 28px; display:flex; align-items:center; gap:22px; box-shadow:0 8px 24px rgba(0,0,0,0.06);\">\n        <img src=\"https://raw.githubusercontent.com/hemanthbv2/rvpu-assets/main/rvps/contact-icon-clock.png\" alt=\"Clock\" style=\"width:62px; height:62px; object-fit:contain;\" />\n        <div>\n          <h4 style=\"font-family:'Inter',sans-serif; font-size:16px; font-weight:800; color:#1c1c1c; margin:0 0 6px 0;\">\n            Office Hours:\n          </h4>\n          <p style=\"font-size:14.5px; line-height:1.55; color:#454545; margin:0;\">\n            Monday to Friday: 8.45 AM – 4.30 PM<br>\n            Saturdays: 10.30 AM – 1.00 PM\n          </p>\n        </div>\n      </div>\n    </div>\n\n    <!-- Right Column: White Feedback / Inquiry Form Card -->\n    <div style=\"flex:1.4 1 480px; background:#ffffff; border-radius:28px; padding:45px 40px; box-shadow:0 15px 40px rgba(0,0,0,0.1);\">\n      <p style=\"font-family:'Inter',sans-serif; font-size:16.5px; font-weight:600; color:#1c1c1c; margin:0 0 25px 0;\">\n        For any feedback or queries, get in touch with us. We will get back to you shortly!\n      </p>\n\n      <form onsubmit=\"event.preventDefault(); alert('Thank you for contacting RV Public School! Our team will get back to you shortly.');\">\n        <div style=\"margin-bottom:18px;\">\n          <input type=\"text\" required placeholder=\"Name\" style=\"width:100%; background:#e8dacb; border:none; border-radius:10px; padding:15px 20px; font-size:15px; color:#1c1c1c; outline:none; box-sizing:border-box;\" />\n        </div>\n\n        <div style=\"margin-bottom:18px;\">\n          <input type=\"email\" required placeholder=\"Email ID\" style=\"width:100%; background:#e8dacb; border:none; border-radius:10px; padding:15px 20px; font-size:15px; color:#1c1c1c; outline:none; box-sizing:border-box;\" />\n        </div>\n\n        <div style=\"margin-bottom:18px;\">\n          <input type=\"text\" required placeholder=\"Subject\" style=\"width:100%; background:#e8dacb; border:none; border-radius:10px; padding:15px 20px; font-size:15px; color:#1c1c1c; outline:none; box-sizing:border-box;\" />\n        </div>\n\n        <div style=\"margin-bottom:28px;\">\n          <textarea rows=\"5\" placeholder=\"Message\" style=\"width:100%; background:#e8dacb; border:none; border-radius:10px; padding:15px 20px; font-size:15px; color:#1c1c1c; outline:none; resize:vertical; box-sizing:border-box;\"></textarea>\n        </div>\n\n        <div>\n          <button type=\"submit\" style=\"display:inline-flex; align-items:center; gap:8px; background:#f2563d; color:#ffffff; font-family:'Inter',sans-serif; font-size:16px; font-weight:700; border:none; padding:15px 38px; border-radius:35px; cursor:pointer; box-shadow:0 6px 20px rgba(242,86,61,0.35); transition:background 0.2s ease;\">\n            <span>Apply Now</span>\n            <span>➔</span>\n          </button>\n        </div>\n      </form>\n    </div>\n  </div>\n</div>\n"
              },
              "elements": []
            }
          ]
        }
      ]
