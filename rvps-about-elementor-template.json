          "elements": [
            {
              "id": "00f4248",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "\n<div style=\"font-family:'Inter',sans-serif; padding: 30px 0 20px 0; display:flex; flex-wrap:wrap; align-items:center; gap:35px;\">\n  <!-- Left Side: Hero Title Banner -->\n  <div style=\"flex:1.3 1 500px;\">\n    <img src=\"https://raw.githubusercontent.com/hemanthbv2/rvpu-assets/main/rvps/about-hero-shaping-title.png\" alt=\"Shaping Young Minds Securing The Future\" style=\"width:100%; max-width:650px; display:block; filter:drop-shadow(0 8px 20px rgba(0,0,0,0.1));\" />\n  </div>\n\n  <!-- Right Side: 3 Element Collage (Lab Photo + 80+ Badge + Classroom Photo) -->\n  <div style=\"flex:1 1 420px; display:flex; flex-direction:column; gap:18px;\">\n    <!-- Top: Lab Photo -->\n    <div style=\"border-radius:24px; overflow:hidden; box-shadow:0 12px 30px rgba(0,0,0,0.12);\">\n      <img src=\"https://raw.githubusercontent.com/hemanthbv2/rvpu-assets/main/rvps/about-hero-classroom-1.png\" alt=\"Science Laboratory\" style=\"width:100%; height:200px; object-fit:cover; display:block;\" />\n    </div>\n\n    <!-- Bottom: 80+ Badge Card + Classroom Photo -->\n    <div style=\"display:grid; grid-template-columns:1fr 1fr; gap:18px; align-items:stretch;\">\n      <div style=\"background:#52b8bb; border-radius:24px; padding:24px 20px; color:#ffffff; box-shadow:0 8px 25px rgba(82,184,187,0.3); display:flex; flex-direction:column; justify-content:center;\">\n        <div style=\"font-family:'Inria Serif',Georgia,serif; font-size:42px; font-weight:700; line-height:1; margin-bottom:10px;\">80+</div>\n        <p style=\"font-size:13.5px; line-height:1.5; margin:0; opacity:0.95;\">\n          years since our journey began under Sri M C Sivananda Sarma\n        </p>\n      </div>\n\n      <div style=\"border-radius:24px; overflow:hidden; box-shadow:0 8px 25px rgba(0,0,0,0.12);\">\n        <img src=\"https://raw.githubusercontent.com/hemanthbv2/rvpu-assets/main/rvps/about-hero-classroom-2.png\" alt=\"Classroom Students\" style=\"width:100%; height:100%; min-height:140px; object-fit:cover; display:block;\" />\n      </div>\n    </div>\n  </div>\n</div>\n"
              },
              "elements": []
            }
          ]
        }
