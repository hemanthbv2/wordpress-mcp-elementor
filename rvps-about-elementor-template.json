          "isInner": false,
          "settings": {
            "_column_size": 100,
            "_inline_size": 100
          },
          "elements": [
            {
              "id": "00f4254",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "\n<div style=\"font-family:'Inter',sans-serif; padding: 25px 0;\">\n  <div style=\"display:flex; justify-content:space-between; align-items:flex-end; flex-wrap:wrap; gap:20px; margin-bottom:50px;\">\n    <div>\n      <div style=\"font-size:13px; font-weight:800; color:#f2563d; text-transform:uppercase; letter-spacing:1.5px; margin-bottom:8px;\">\n        • HOW WE TEACH\n      </div>\n      <h2 style=\"font-family:'Inria Serif',Georgia,serif; font-size:46px; font-weight:700; color:#1c1c1c; margin:0;\">\n        Objectives of the school\n      </h2>\n    </div>\n    <div style=\"max-width:440px; font-size:15.5px; color:#555555; line-height:1.6;\">\n      Our mission is to recognise and enhance each individual's special talents and never to reject any child.\n    </div>\n  </div>\n\n  <!-- 3 Steps with Connecting Line -->\n  <div style=\"position:relative; display:grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap:35px;\">\n    <!-- Step 01 -->\n    <div>\n      <div style=\"width:48px; height:48px; background:#f3b23e; border-radius:50%; color:#ffffff; font-weight:800; font-size:18px; display:flex; align-items:center; justify-content:center; margin-bottom:20px; box-shadow:0 4px 12px rgba(243,178,62,0.35);\">\n        01\n      </div>\n      <h3 style=\"font-family:'Inria Serif',Georgia,serif; font-size:22px; font-weight:700; color:#1c1c1c; margin:0 0 10px 0;\">\n        Recognise every talent\n      </h3>\n      <p style=\"font-size:15px; line-height:1.7; color:#555555; margin:0;\">\n        All students have unique talents, whether in academics, sports, communication, technology, art, craft, or drama.\n      </p>\n    </div>\n\n    <!-- Step 02 -->\n    <div>\n      <div style=\"width:48px; height:48px; background:#52b8bb; border-radius:50%; color:#ffffff; font-weight:800; font-size:18px; display:flex; align-items:center; justify-content:center; margin-bottom:20px; box-shadow:0 4px 12px rgba(82,184,187,0.35);\">\n        02\n      </div>\n      <h3 style=\"font-family:'Inria Serif',Georgia,serif; font-size:22px; font-weight:700; color:#1c1c1c; margin:0 0 10px 0;\">\n        Learn actively, holistically\n      </h3>\n      <p style=\"font-size:15px; line-height:1.7; color:#555555; margin:0;\">\n        Our teaching methodology exposes students to a holistic experience in an active and dynamic learning environment.\n      </p>\n    </div>\n\n    <!-- Step 03 -->\n    <div>\n      <div style=\"width:48px; height:48px; background:#f2563d; border-radius:50%; color:#ffffff; font-weight:800; font-size:18px; display:flex; align-items:center; justify-content:center; margin-bottom:20px; box-shadow:0 4px 12px rgba(242,86,61,0.35);\">\n        03\n      </div>\n      <h3 style=\"font-family:'Inria Serif',Georgia,serif; font-size:22px; font-weight:700; color:#1c1c1c; margin:0 0 10px 0;\">\n        Realise their potential\n      </h3>\n      <p style=\"font-size:15px; line-height:1.7; color:#555555; margin:0;\">\n        Giving them the opportunity to identify and realise their potential and achieve excellence.\n      </p>\n    </div>\n  </div>\n</div>\n"
              },
              "elements": []
            }
          ]
        }
      ]
    },
