            {
              "id": "00f4251",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "\n<div style=\"font-family:'Inter',sans-serif; padding: 25px 0;\">\n  <div style=\"background:#1c1c1c; border-radius:32px; overflow:hidden; display:flex; flex-wrap:wrap; align-items:stretch; box-shadow:0 15px 40px rgba(0,0,0,0.25);\">\n    <div style=\"flex:1.2 1 450px; padding:60px 50px; color:#ffffff; display:flex; flex-direction:column; justify-content:center;\">\n      <h2 style=\"font-family:'Inria Serif',Georgia,serif; font-size:48px; font-weight:700; color:#ffffff; margin:0 0 24px 0; line-height:1.15; letter-spacing:0.5px;\">\n        OUR<br>MOTTO\n      </h2>\n      <p style=\"font-size:16.5px; line-height:1.8; color:#d0d0d0; margin:0;\">\n        Diligence is undertaken in our case through the management and teaching staff constantly and earnestly working towards our goal of building the leaders of tomorrow. Determination is the essential ingredient for whoever wishes to have success — the determination to provide quality education, and the best of opportunities, has helped our children scale new heights.\n      </p>\n    </div>\n    <div style=\"flex:1.4 1 500px; min-height:360px;\">\n      <img src=\"https://raw.githubusercontent.com/hemanthbv2/rvpu-assets/main/rvps/about-motto-stairs.png\" alt=\"Students on Steps\" style=\"width:100%; height:100%; object-fit:cover; display:block;\" />\n    </div>\n  </div>\n</div>\n"
              },
              "elements": []
            }
          ]
        }
      ]
    },
    {
      "id": "00f4256",
      "elType": "section",
      "isInner": false,
      "settings": {
