          "elements": [
            {
              "id": "00f4248",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "\n<div style=\"font-family:'Inter',sans-serif; padding: 30px 0 20px 0; display:flex; flex-wrap:wrap; gap:30px; align-items:stretch;\">\n  <!-- Left Column: Teal Card with Mascot -->\n  <div style=\"flex:1.4 1 520px; background:#52b8bb; border-radius:36px; padding:45px 40px 30px 40px; color:#ffffff; position:relative; box-shadow:0 15px 40px rgba(82,184,187,0.3); display:flex; flex-direction:column; justify-content:space-between;\">\n    <div>\n      <div style=\"background:#1c1c1c; color:#ffffff; font-size:12px; font-weight:800; text-transform:uppercase; letter-spacing:1.5px; padding:6px 18px; border-radius:20px; display:inline-block; margin-bottom:25px;\">\n        • ALUMNI NETWORK\n      </div>\n\n      <h1 style=\"font-family:'Inria Serif',Georgia,serif; font-size:56px; font-weight:700; color:#1c1c1c; line-height:1.15; margin:0 0 20px 0;\">\n        Keep the RVian<br>spirit <span style=\"background:#f2563d; color:#1c1c1c; padding:2px 18px; border-radius:14px; display:inline-block;\">aflame!</span>\n      </h1>\n\n      <p style=\"font-size:17.5px; line-height:1.65; color:#f0fffe; max-width:440px; margin:0 0 35px 0;\">\n        Stay connected with your friends and alma mater through our alumni portal. Log on to Alma Connect and continue being a part of the RV community.\n      </p>\n\n      <div style=\"display:flex; align-items:center; gap:16px; flex-wrap:wrap;\">\n        <a href=\"https://rvps.almaconnect.com\" target=\"_blank\" style=\"display:inline-flex; align-items:center; gap:8px; background:#1c1c1c; color:#ffffff; font-weight:700; font-size:15px; padding:13px 28px; border-radius:30px; text-decoration:none;\">\n          <span>Log on to Alma Connect</span>\n          <span>↗</span>\n        </a>\n        <a href=\"#alumni-stories\" style=\"display:inline-block; background:transparent; border:1.5px solid #1c1c1c; color:#1c1c1c; font-weight:700; font-size:15px; padding:12px 26px; border-radius:30px; text-decoration:none;\">\n          Read alumni stories\n        </a>\n      </div>\n    </div>\n\n    <!-- Eagle Mascot Standing on Edge -->\n    <div style=\"text-align:right; margin-top:20px;\">\n      <img src=\"https://raw.githubusercontent.com/hemanthbv2/rvpu-assets/main/rvps/alumni-eagle-books.png\" alt=\"RVPS Mascot with Books\" style=\"max-height:360px; object-fit:contain; filter:drop-shadow(0 12px 25px rgba(0,0,0,0.25));\" />\n    </div>\n  </div>\n\n  <!-- Right Column: Alumnus Photo with Pill + Gold Once an RVian Card -->\n  <div style=\"flex:1 1 380px; display:flex; flex-direction:column; gap:22px;\">\n    <!-- Alumnus Photo Card -->\n    <div style=\"border-radius:32px; overflow:hidden; position:relative; box-shadow:0 12px 30px rgba(0,0,0,0.12);\">\n      <img src=\"https://raw.githubusercontent.com/hemanthbv2/rvpu-assets/main/rvps/alumni-hero-badge.png\" alt=\"Alumnus on Campus\" style=\"width:100%; height:320px; object-fit:cover; display:block;\" />\n      <div style=\"position:absolute; bottom:18px; left:20px; right:20px; background:#ffffff; border-radius:18px; padding:12px 18px; display:flex; align-items:center; gap:12px; box-shadow:0 4px 15px rgba(0,0,0,0.1);\">\n        <div style=\"width:36px; height:36px; background:#f3b23e; border-radius:50%; display:flex; align-items:center; justify-content:center; color:#ffffff; font-size:18px;\">\n          🎓\n        </div>\n        <div>\n          <div style=\"font-family:'Inter',sans-serif; font-size:13.5px; font-weight:800; color:#1c1c1c;\">Alma Connect</div>\n          <div style=\"font-size:11.5px; color:#777777;\">The RV alumni portal</div>\n        </div>\n      </div>\n    </div>\n\n    <!-- Gold Card: Once an RVian, Always an RVian -->\n    <div style=\"border-radius:28px; overflow:hidden; box-shadow:0 10px 30px rgba(243,178,62,0.25);\">\n      <img src=\"https://raw.githubusercontent.com/hemanthbv2/rvpu-assets/main/rvps/alumni-once-always-card.png\" alt=\"Once an RVian Always an RVian\" style=\"width:100%; display:block;\" />\n    </div>\n  </div>\n</div>\n"
              },
              "elements": []
            }
          ]
        }
      ]
