          "elements": [
            {
              "id": "00f424b",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "\n<div id=\"alumni-stories\" style=\"font-family:'Inter',sans-serif; padding: 30px 0 50px 0;\">\n  <div style=\"display:flex; justify-content:space-between; align-items:flex-end; flex-wrap:wrap; gap:20px; margin-bottom:45px;\">\n    <div>\n      <div style=\"font-size:13px; font-weight:800; color:#f2563d; text-transform:uppercase; letter-spacing:1.5px; margin-bottom:8px;\">\n        • OUR ALUMNI\n      </div>\n      <h2 style=\"font-family:'Inria Serif',Georgia,serif; font-size:48px; font-weight:700; color:#1c1c1c; margin:0 0 10px 0;\">\n        Success stories\n      </h2>\n      <p style=\"font-size:16px; color:#555555; margin:0;\">\n        Here are our RVians who have left their marks in their respective fields!\n      </p>\n    </div>\n\n    <!-- 01/02 Pagination Buttons -->\n    <div style=\"display:flex; align-items:center; gap:16px;\">\n      <span style=\"font-family:'Inter',sans-serif; font-size:22px; font-weight:800; color:#1c1c1c;\">01<span style=\"font-size:15px; color:#888888; font-weight:600;\">/02</span></span>\n      <button style=\"width:40px; height:40px; border-radius:50%; border:1.5px solid #1c1c1c; background:#ffffff; color:#1c1c1c; font-size:16px; cursor:pointer; display:flex; align-items:center; justify-content:center;\">\n        ‹\n      </button>\n      <button style=\"width:40px; height:40px; border-radius:50%; border:none; background:#f2563d; color:#ffffff; font-size:16px; cursor:pointer; display:flex; align-items:center; justify-content:center;\">\n        ›\n      </button>\n    </div>\n  </div>\n\n  <!-- 2 Story Cards -->\n  <div style=\"display:grid; grid-template-columns:1.5fr 1fr; gap:30px; align-items:stretch;\">\n    <!-- Card 1: Dark Card with Alumnus Photo & Quote -->\n    <div style=\"background:#1c1c1c; border-radius:32px; overflow:hidden; display:flex; flex-wrap:wrap; align-items:center; box-shadow:0 15px 40px rgba(0,0,0,0.2);\">\n      <div style=\"flex:1 1 240px; height:100%; min-height:300px;\">\n        <img src=\"https://raw.githubusercontent.com/hemanthbv2/rvpu-assets/main/rvps/alumni-story-1.png\" alt=\"Dr. Vikram Kulkarni\" style=\"width:100%; height:100%; object-fit:cover; display:block;\" />\n      </div>\n      <div style=\"flex:1.4 1 280px; padding:35px 30px; color:#ffffff;\">\n        <div style=\"display:inline-block; background:#f3b23e; color:#1c1c1c; font-size:12px; font-weight:800; padding:6px 16px; border-radius:15px; margin-bottom:20px;\">\n          3 years at RVPS\n        </div>\n        <p style=\"font-size:16.5px; line-height:1.75; color:#dcdcdc; margin:0;\">\n          “Joining RV Public School was one of the best decisions of my life. Beyond academics, the school gave us many opportunities in extracurricular activities. It helped me find my passion for coding — and today it has become my career.”\n        </p>\n      </div>\n    </div>\n\n    <!-- Card 2: Female Alumna on Steps Photo -->\n    <div style=\"border-radius:32px; overflow:hidden; box-shadow:0 15px 40px rgba(0,0,0,0.15);\">\n      <img src=\"https://raw.githubusercontent.com/hemanthbv2/rvpu-assets/main/rvps/alumni-story-female.png\" alt=\"Alumna on Campus Steps\" style=\"width:100%; height:100%; min-height:300px; object-fit:cover; display:block;\" />\n    </div>\n  </div>\n</div>\n"
              },
              "elements": []
            }
          ]
        }
      ]
    },
