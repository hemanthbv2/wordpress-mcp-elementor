              "settings": {
                "html": "\n<style>\n.rvps-nav-wrap { display: flex; align-items: center; justify-content: center; gap: 28px; flex-wrap: wrap; }\n.rvps-nav-link { font-family: 'Inter', sans-serif; font-size: 15px; font-weight: 600; color: #1c1c1c; text-decoration: none; padding: 8px 12px; border-radius: 6px; transition: all 0.25s ease; position: relative; }\n.rvps-nav-link:hover { color: #f2563d; background: rgba(242, 86, 61, 0.06); }\n.rvps-nav-link.active { color: #f2563d; font-weight: 700; }\n.rvps-nav-link.active::after { content: ''; position: absolute; bottom: 0; left: 12px; right: 12px; height: 3px; background: #f2563d; border-radius: 2px; }\n.rvps-palette-dots { display: flex; gap: 5px; align-items: center; justify-content: flex-end; }\n.rvps-palette-dot { width: 14px; height: 28px; border-radius: 4px; display: inline-block; }\n@media (max-width: 900px) {\n  .rvps-nav-wrap { gap: 14px; justify-content: center; }\n  .rvps-nav-link { font-size: 13.5px; padding: 6px 8px; }\n}\n</style>\n<div class=\"rvps-nav-wrap\">\n  \n    <a href=\"https://rvcollegeofengineering.in/test/?page_id=99\" class=\"rvps-nav-link \">\n      Home\n    </a>\n  \n    <a href=\"https://rvcollegeofengineering.in/test/?page_id=100\" class=\"rvps-nav-link \">\n      About Us\n    </a>\n  \n    <a href=\"https://rvcollegeofengineering.in/test/?page_id=101\" class=\"rvps-nav-link \">\n      Academics\n    </a>\n  \n    <a href=\"https://rvcollegeofengineering.in/test/?page_id=102\" class=\"rvps-nav-link \">\n      Events\n    </a>\n  \n    <a href=\"https://rvcollegeofengineering.in/test/?page_id=103\" class=\"rvps-nav-link \">\n      Results\n    </a>\n  \n    <a href=\"https://rvcollegeofengineering.in/test/?page_id=104\" class=\"rvps-nav-link active\">\n      Alumni\n    </a>\n  \n    <a href=\"https://rvcollegeofengineering.in/test/?page_id=105\" class=\"rvps-nav-link \">\n      Contact Us\n    </a>\n  \n</div>\n"
