                "html": "\n<div style=\"font-family:'Inter',sans-serif; height:240px; background:radial-gradient(circle at 15% 20%, #f2563d 60px, transparent 61px), radial-gradient(circle at 85% 80%, #52b8bb 70px, transparent 71px), #f3b23e; border-radius:0 0 40px 40px; position:relative; overflow:hidden;\">\n  <div style=\"position:absolute; inset:0; background-image:linear-gradient(rgba(255,255,255,0.18) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.18) 1px, transparent 1px); background-size:50px 50px;\"></div>\n</div>\n"
