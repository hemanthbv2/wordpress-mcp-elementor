              "id": "00f424b",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "\n<div id=\"results-podium\" style=\"font-family:'Inter',sans-serif; padding: 30px 0;\">\n  <div style=\"margin-bottom: 40px;\">\n    <div style=\"font-size:13px; font-weight:800; color:#f2563d; text-transform:uppercase; letter-spacing:1.5px; margin-bottom:8px;\">\n      • RESULTS\n    </div>\n    <h2 style=\"font-family:'Inria Serif',Georgia,serif; font-size:48px; font-weight:700; color:#1c1c1c; margin:0;\">\n      Our ICSE toppers, <span style=\"color:#52b8bb;\">2025</span>\n    </h2>\n  </div>\n\n  <!-- 3 Podium Cards -->\n  <div style=\"display:grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap:30px;\">\n    <!-- Topper 1 -->\n    <div style=\"background:#eaf2f8; border-radius:26px; overflow:hidden; position:relative; box-shadow:0 10px 30px rgba(0,0,0,0.06);\">\n      <div style=\"position:absolute; top:18px; left:18px; width:44px; height:44px; background:#1c1c1c; color:#ffffff; font-family:'Inter',sans-serif; font-size:16px; font-weight:800; border-radius:50%; display:flex; align-items:center; justify-content:center; z-index:2;\">\n        #01\n      </div>\n      <div style=\"height:360px; overflow:hidden;\">\n        <img src=\"https://raw.githubusercontent.com/hemanthbv2/rvpu-assets/main/rvps/results-topper-1.png\" alt=\"Student Topper 1\" style=\"width:100%; height:100%; object-fit:cover; object-position:top;\" />\n      </div>\n      <!-- Gold Bottom Bar -->\n      <div style=\"background:#f3b23e; padding:18px 24px; display:flex; justify-content:space-between; align-items:center;\">\n        <div>\n          <h4 style=\"font-family:'Inter',sans-serif; font-size:19px; font-weight:800; color:#1c1c1c; margin:0 0 2px 0;\">[Student name]</h4>\n          <span style=\"font-size:13px; font-weight:600; color:#3a3a3a;\">ICSE Class X</span>\n        </div>\n        <div style=\"font-family:'Inter',sans-serif; font-size:32px; font-weight:800; color:#1c1c1c;\">\n          [XX.X]%\n        </div>\n      </div>\n    </div>\n\n    <!-- Topper 2 -->\n    <div style=\"background:#eaf2f8; border-radius:26px; overflow:hidden; position:relative; box-shadow:0 10px 30px rgba(0,0,0,0.06);\">\n      <div style=\"position:absolute; top:18px; left:18px; width:44px; height:44px; background:#1c1c1c; color:#ffffff; font-family:'Inter',sans-serif; font-size:16px; font-weight:800; border-radius:50%; display:flex; align-items:center; justify-content:center; z-index:2;\">\n        #02\n      </div>\n      <div style=\"height:360px; overflow:hidden;\">\n        <img src=\"https://raw.githubusercontent.com/hemanthbv2/rvpu-assets/main/rvps/results-topper-2.png\" alt=\"Student Topper 2\" style=\"width:100%; height:100%; object-fit:cover; object-position:top;\" />\n      </div>\n      <div style=\"background:#f3b23e; padding:18px 24px; display:flex; justify-content:space-between; align-items:center;\">\n        <div>\n          <h4 style=\"font-family:'Inter',sans-serif; font-size:19px; font-weight:800; color:#1c1c1c; margin:0 0 2px 0;\">[Student name]</h4>\n          <span style=\"font-size:13px; font-weight:600; color:#3a3a3a;\">ICSE Class X</span>\n        </div>\n        <div style=\"font-family:'Inter',sans-serif; font-size:32px; font-weight:800; color:#1c1c1c;\">\n          [XX.X]%\n        </div>\n      </div>\n    </div>\n\n    <!-- Topper 3 -->\n    <div style=\"background:#eaf2f8; border-radius:26px; overflow:hidden; position:relative; box-shadow:0 10px 30px rgba(0,0,0,0.06);\">\n      <div style=\"position:absolute; top:18px; left:18px; width:44px; height:44px; background:#1c1c1c; color:#ffffff; font-family:'Inter',sans-serif; font-size:16px; font-weight:800; border-radius:50%; display:flex; align-items:center; justify-content:center; z-index:2;\">\n        #03\n      </div>\n      <div style=\"height:360px; overflow:hidden;\">\n        <img src=\"https://raw.githubusercontent.com/hemanthbv2/rvpu-assets/main/rvps/results-topper-3.png\" alt=\"Student Topper 3\" style=\"width:100%; height:100%; object-fit:cover; object-position:top;\" />\n      </div>\n      <div style=\"background:#f3b23e; padding:18px 24px; display:flex; justify-content:space-between; align-items:center;\">\n        <div>\n          <h4 style=\"font-family:'Inter',sans-serif; font-size:19px; font-weight:800; color:#1c1c1c; margin:0 0 2px 0;\">[Student name]</h4>\n          <span style=\"font-size:13px; font-weight:600; color:#3a3a3a;\">ICSE Class X</span>\n        </div>\n        <div style=\"font-family:'Inter',sans-serif; font-size:32px; font-weight:800; color:#1c1c1c;\">\n          [XX.X]%\n        </div>\n      </div>\n    </div>\n  </div>\n</div>\n"
