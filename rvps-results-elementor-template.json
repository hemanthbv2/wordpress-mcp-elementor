      "elements": [
        {
          "id": "00f4249",
          "elType": "column",
          "isInner": false,
          "settings": {
            "_column_size": 100,
            "_inline_size": 100
          },
          "elements": [
            {
              "id": "00f4248",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "\n<div style=\"font-family:'Inter',sans-serif; padding: 40px 0 20px 0;\">\n  <!-- Top Badge -->\n  <div style=\"margin-bottom:20px;\">\n    <div style=\"display:inline-block; background:#ffffff; color:#1c1c1c; font-size:12px; font-weight:800; text-transform:uppercase; letter-spacing:1.5px; padding:6px 20px; border-radius:20px; box-shadow:0 3px 10px rgba(0,0,0,0.06);\">\n      • ICSE RESULTS • [2025]\n    </div>\n  </div>\n\n  <!-- Title with Huge Tilted SHOUTOUT Banner -->\n  <div style=\"display:flex; align-items:center; flex-wrap:wrap; gap:20px; margin-bottom:15px;\">\n    <h1 style=\"font-family:'Inria Serif',Georgia,serif; font-size:58px; font-weight:700; color:#1c1c1c; margin:0; line-height:1.15;\">\n      Good work deserves a\n    </h1>\n    <img src=\"https://raw.githubusercontent.com/hemanthbv2/rvpu-assets/main/rvps/results-shoutout-banner.png\" alt=\"SHOUTOUT\" style=\"height:90px; object-fit:contain; filter:drop-shadow(0 8px 18px rgba(0,0,0,0.15));\" />\n  </div>\n\n  <!-- Subtitle -->\n  <p style=\"font-size:16.5px; color:#1c1c1c; max-width:650px; line-height:1.6; margin:0 0 35px 0;\">\n    Every year our students make us proud. Here's how the class of [2025] did in the ICSE examinations — and the people behind the numbers.\n  </p>\n\n  <!-- Mascot + 3 Stacked Pills + Oval Students Photo -->\n  <div style=\"display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:35px;\">\n    <!-- Left: Eagle Mascot Raising Finger + 3 Stacked Horizontal Stat Pills -->\n    <div style=\"flex:1.4 1 500px; display:flex; align-items:center; gap:25px;\">\n      <!-- Mascot -->\n      <div style=\"flex:0 0 220px; text-align:center;\">\n        <img src=\"https://raw.githubusercontent.com/hemanthbv2/rvpu-assets/main/rvps/results-eagle-mascot.png\" alt=\"Cheerful Eagle Mascot\" style=\"max-height:360px; object-fit:contain; filter:drop-shadow(0 10px 20px rgba(0,0,0,0.15));\" />\n      </div>\n\n      <!-- 3 Stacked Pills -->\n      <div style=\"flex:1; display:flex; flex-direction:column; gap:16px;\">\n        <!-- Pill 1: Coral -->\n        <div style=\"background:#f2563d; border-radius:22px; padding:18px 24px; color:#ffffff; box-shadow:0 6px 18px rgba(242,86,61,0.25);\">\n          <div style=\"font-family:'Inria Serif',Georgia,serif; font-size:34px; font-weight:800; line-height:1; margin-bottom:4px;\">[XX]</div>\n          <div style=\"font-size:13.5px; font-weight:600; opacity:0.95;\">students scored 90% and above</div>\n        </div>\n\n        <!-- Pill 2: Gold -->\n        <div style=\"background:#f3b23e; border-radius:22px; padding:18px 24px; color:#1c1c1c; box-shadow:0 6px 18px rgba(243,178,62,0.25);\">\n          <div style=\"font-family:'Inria Serif',Georgia,serif; font-size:34px; font-weight:800; line-height:1; margin-bottom:4px;\">[XX]%</div>\n          <div style=\"font-size:13.5px; font-weight:600; color:#3a3a3a;\">school average</div>\n        </div>\n\n        <!-- Pill 3: White -->\n        <div style=\"background:#ffffff; border-radius:22px; padding:18px 24px; color:#1c1c1c; box-shadow:0 6px 18px rgba(0,0,0,0.06);\">\n          <div style=\"font-family:'Inria Serif',Georgia,serif; font-size:34px; font-weight:800; line-height:1; color:#52b8bb; margin-bottom:4px;\">[XX]</div>\n          <div style=\"font-size:13.5px; font-weight:600; color:#555555;\">perfect 100s across subjects</div>\n        </div>\n      </div>\n    </div>\n\n    <!-- Right: Oval Students Photo + 2 Buttons -->\n    <div style=\"flex:1 1 360px; text-align:center;\">\n      <div style=\"border-radius:180px; overflow:hidden; border:6px solid #f3b23e; box-shadow:0 15px 35px rgba(0,0,0,0.15); margin-bottom:25px;\">\n        <img src=\"https://raw.githubusercontent.com/hemanthbv2/rvpu-assets/main/rvps/results-oval-students.png\" alt=\"RVPS Students\" style=\"width:100%; height:260px; object-fit:cover; display:block;\" />\n      </div>\n      <div style=\"display:flex; justify-content:center; gap:14px; flex-wrap:wrap;\">\n        <a href=\"#results-podium\" style=\"display:inline-flex; align-items:center; gap:6px; background:#1c1c1c; color:#ffffff; font-size:14px; font-weight:700; padding:12px 26px; border-radius:30px; text-decoration:none;\">\n          <span>Meet our toppers</span>\n          <span>↓</span>\n        </a>\n        <a href=\"https://rvcollegeofengineering.in/test/?page_id=105\" style=\"display:inline-flex; align-items:center; gap:6px; background:transparent; border:1.5px solid #1c1c1c; color:#1c1c1c; font-size:14px; font-weight:700; padding:12px 26px; border-radius:30px; text-decoration:none;\">\n          Book a campus visit\n        </a>\n      </div>\n    </div>\n  </div>\n</div>\n"
              },
              "elements": []
            }
          ]
        }
      ]
    },
